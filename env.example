# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Apple Sign-In Configuration
VITE_APPLE_CLIENT_ID=your-apple-service-id-here
VITE_APPLE_REDIRECT_URI=https://your-domain.com

# Replace the above with your actual credentials from Google Console and Apple Developer Account
